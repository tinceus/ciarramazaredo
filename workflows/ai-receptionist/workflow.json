    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Check when the calendar is busy between two ISO date-times.",
        "resource": "calendar",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "timeMin": "={{ $fromAI('start', 'ISO start of the window to check', 'string') }}",
        "timeMax": "={{ $fromAI('end', 'ISO end of the window to check', 'string') }}",
        "options": {}
      },
      "id": "c8884507-30a4-5858-9049-0b99b19f5de9",
      "name": "Check availability",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        460,
        240
      ]
    },
    {
      "parameters": {
