        "additionalFields": {
          "summary": "={{ $fromAI('title', 'Visitor name and reason', 'string') }}",
          "attendees": [
            "={{ $fromAI('email', 'Visitor email', 'string') }}"
          ]
        }
      },
      "id": "d2291405-81b3-575e-bd8d-799fdbe2d2ec",
