{
  "name": "Inbox triage and daily brief",
  "nodes": [
    {
      "parameters": {
        "content": "## Inbox triage and daily brief\nEvery new email is sorted and labeled. Emails that need a reply get a draft, never a sent message. Each morning one short brief lists what needs the leader.\n\nConnect Gmail and Anthropic after import, and create the five labels.",
        "height": 200,
        "width": 440,
        "color": 4
      },
      "id": "f8ff44e7-c244-5e8b-8c01-a5dcdfc2891e",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -320
      ]
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 5,
              "unit": "minutes"
            }
          ]
        },
        "simple": false,
        "filters": {
          "labelIds": [
            "INBOX"
          ]
        },
        "options": {}
      },
      "id": "e05b40df-7b08-5547-8a66-927fb95a758b",
      "name": "New email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "inputText": "=From: {{ $json.from.text }}\nSubject: {{ $json.subject }}\n\n{{ $json.text }}",
        "categories": {
          "categories": [
            {
              "category": "Urgent",
              "description": "Needs action today: a deadline, an outage, a leader or client waiting."
            },
            {
              "category": "Needs reply",
              "description": "A real person asked a question or proposed something."
            },
            {
              "category": "Billing",
              "description": "Invoices, receipts, payments, subscriptions."
            },
            {
              "category": "FYI",
              "description": "Updates to read later with no action needed."
            },
            {
              "category": "Newsletter",
              "description": "Bulk or marketing email."
            }
          ]
        },
        "options": {
          "fallback": "other"
        }
      },
      "id": "8f2cb5c3-80ca-5626-983e-1eeef87b7c16",
      "name": "Sort email",
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1.1,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-sonnet-5-5"
        },
        "options": {
          "temperature": 0
        }
      },
      "id": "6f9ff2bc-5a7d-56c1-9df0-f31c68568949",
      "name": "Claude (sorting)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        260,
        220
      ]
    },
    {
      "parameters": {
        "operation": "addLabels",
        "messageId": "={{ $json.id }}",
        "labelIds": [
          "Urgent"
        ]
      },
      "id": "9540bb1c-4a3d-568d-b2b3-c88ae7641560",
      "name": "Label: Urgent",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
