      "typeVersion": 2.1,
      "position": [
        560,
        0
      ]
    },
    {
      "parameters": {
        "operation": "addLabels",
        "messageId": "={{ $json.id }}",
        "labelIds": [
          "FYI"
        ]
      },
      "id": "9a98eaee-e938-5f3e-8a64-0b575c5b2516",
      "name": "Label: FYI",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        560,
        130
      ]
    },
    {
      "parameters": {
        "operation": "addLabels",
        "messageId": "={{ $json.id }}",
        "labelIds": [
          "Newsletter"
