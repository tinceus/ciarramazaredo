      "name": "Label: Newsletter",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        560,
        260
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Draft a short, polite reply for the leader to review. Match their tone, answer only what was asked, and mark anything you are unsure of with [CHECK].\n\nFrom: {{ $('New email').item.json.from.text }}\nSubject: {{ $('New email').item.json.subject }}\n\n{{ $('New email').item.json.text }}"
      },
      "id": "19be4ec5-a80f-5803-96dc-aa10f81c03ec",
      "name": "Draft a reply",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        820,
        -130
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-sonnet-5-5"
        },
        "options": {
          "temperature": 0.3
        }
      },
      "id": "b784fbee-85c4-5059-a3de-a8ba94664db9",
      "name": "Claude (drafting)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        820,
        80
      ]
    },
    {
      "parameters": {
        "resource": "draft",
        "subject": "=Re: {{ $('New email').item.json.subject }}",
        "emailType": "text",
        "message": "={{ $json.text }}",
        "options": {
          "threadId": "={{ $('New email').item.json.threadId }}",
          "sendTo": "={{ $('New email').item.json.from.value[0].address }}"
        }
      },
      "id": "36c021d0-3d5b-5c79-99c3-4e33fe1685cb",
      "name": "Save as draft (never send)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1060,
        -130
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 7 * * 1-5"
            }
          ]
        }
      },
      "id": "d310b802-aca0-596b-b575-236f51af25ee",
      "name": "Every weekday 7:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        520
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "returnAll": true,
        "simple": true,
        "filters": {
          "q": "newer_than:1d (label:Urgent OR label:\"Needs reply\" OR label:Billing)"
        }
      },
      "id": "43cd1b07-3f7e-54b3-b1c4-0959e10e8698",
      "name": "Get last 24 hours",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        260,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "const lines = $input.all().map(i => `- ${i.json.From || i.json.from}: ${i.json.Subject || i.json.subject}`);\nreturn [{ json: { list: lines.join('\\n'), count: lines.length } }];"
      },
      "id": "0994b5c1-e688-56ed-a393-554df5ae8321",
      "name": "List them",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        520
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a morning brief of at most 8 lines for a busy leader. Group into Do today, Reply, Pay. Use only the emails listed. Never add items.\n\n{{ $json.list }}"
      },
      "id": "09a09deb-21c6-5738-9dae-1338cc550554",
      "name": "Write the brief",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
