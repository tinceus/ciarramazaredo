{
  "name": "Error alerts",
  "nodes": [
    {
      "parameters": {
        "content": "## Error alerts\nSet this as the error workflow for every other workflow (Workflow settings, Error workflow). When any run fails, the team hears about it within a minute, with a link to the failed run.",
        "height": 180,
        "width": 420,
        "color": 4
      },
      "id": "f8ff44e7-c244-5e8b-8c01-a5dcdfc2891e",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -280
      ]
    },
    {
      "parameters": {},
      "id": "173b167b-4bf9-554d-b52a-eb5cbb8efb7c",
      "name": "When any workflow fails",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#ops-alerts"
        },
        "text": "=Failed: {{ $json.workflow.name }}\nStep: {{ $json.execution.lastNodeExecuted }}\nError: {{ $json.execution.error.message }}\nRun: {{ $json.execution.url }}",
        "otherOptions": {}
      },
      "id": "1cc7a4aa-f2ba-58ba-ad0e-59497425cb1a",
      "name": "Alert on Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "you@example.com",
        "subject": "=Workflow failed: {{ $json.workflow.name }}",
        "emailType": "text",
        "message": "=Step: {{ $json.execution.lastNodeExecuted }}\nError: {{ $json.execution.error.message }}\nRun: {{ $json.execution.url }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "6215ce96-8719-5834-9791-d8db8694d782",
      "name": "Email backup alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        240,
        200
      ]
    }
  ],
  "connections": {
    "When any workflow fails": {
      "main": [
        [
          {
            "node": "Alert on Slack",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email backup alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [
    {
      "name": "Nothing breaks silently"
    }
  ],
  "pinData": {}
}
