{
  "name": "Error alerts",
  "nodes": [
    {
      "parameters": {
        "content": "## Error alerts\nSet this as the error workflow for every other workflow (Workflow settings, Error workflow). When an assigned workflow fails, it sends a Slack alert and a backup email. The email still goes out if Slack fails. The link to the failed run appears when n8n supplies one.",
        "height": 180,
        "width": 420,
        "color": 4
      },
      "id": "f8ff44e7-c244-5e8b-8c01-a5dcdfc2891e",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -280
      ]
    },
    {
      "parameters": {},
      "id": "173b167b-4bf9-554d-b52a-eb5cbb8efb7c",
      "name": "When any workflow fails",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "function normalizeError(event) {\n  const execution = event.execution || {}, trigger = event.trigger || {};\n  const error = execution.error || trigger.error || {};\n  return {\n    workflow: event.workflow?.name || 'Unknown workflow',\n    step: execution.lastNodeExecuted || error.node?.name || trigger.mode || 'Trigger / unavailable',\n    message: error.message || error.cause?.message || 'No error message supplied',\n    url: execution.url || 'No execution URL supplied'\n  };\n}\n\n\nreturn $input.all().map(i => ({json: normalizeError(i.json)}));\n"
      },
      "id": "36ff4435-d6a8-55ab-b5cc-9164f505f75f",
      "name": "Normalize error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        0
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#ops-alerts"
        },
        "text": "=Failed: {{ $json.workflow }}\nStep: {{ $json.step }}\nError: {{ $json.message }}\nRun: {{ $json.url }}",
        "otherOptions": {}
      },
      "id": "1cc7a4aa-f2ba-58ba-ad0e-59497425cb1a",
      "name": "Alert on Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        400,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "sendTo": "you@example.com",
        "subject": "=Workflow failed: {{ $json.workflow }}",
        "emailType": "text",
        "message": "=Step: {{ $json.step }}\nError: {{ $json.message }}\nRun: {{ $json.url }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "6215ce96-8719-5834-9791-d8db8694d782",
      "name": "Email backup alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        400,
        200
      ]
    }
  ],
  "connections": {
    "When any workflow fails": {
      "main": [
        [
          {
            "node": "Normalize error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize error": {
      "main": [
        [
          {
            "node": "Alert on Slack",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email backup alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "timezone": "Asia/Manila"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [
    {
      "name": "Nothing breaks silently"
    }
  ],
  "pinData": {}
}
